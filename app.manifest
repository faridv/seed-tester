<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="RockeyPasswordTester.app" />

  <!--
    The app requires administrator rights so it can programmatically disable/enable
    (virtually unplug/replug) the Rockey dongle's OWN USB device node when it wedges.
    Disable-PnpDevice / Enable-PnpDevice fail silently without elevation. Recovery is now
    strictly device-scoped (limited to USB\VID_096E&PID_0006), so it can NEVER cycle a USB
    hub and can never disturb the keyboard, Bluetooth or other devices - unlike the old
    hub power-cycle. A single UAC prompt at launch lets unattended overnight runs self-heal.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v2">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
